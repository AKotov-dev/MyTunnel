[NAME]
name=mytunnel

[VERSION]
version=0.1

[RELEASE]
release=0.mrx10

[GROUP]
group=Accessibility

[DESCRIPTION]
0=Simple SSH tunnel manager
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Simple SSH tunnel manager

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/MyTunnel

[LICENSE]
license=GPL-3.0-or-later

[DEPS]
deps=libgtk2.0-0 openssh-client sshpass systemd

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=1

[FILES]
0=/usr/share/pixmaps/mytunnel.png
1=/etc/systemd/user/mytunnel.service
2=/usr/share/applications/mytunnel.desktop
3=/usr/share/mytunnel/
4=/usr/share/doc/mytunnel/

[AFTERINSTALL]
0=#!/bin/bash
1=
2=systemctl daemon-reload

[AFTERREMOVE]
0=#!/bin/bash
1=
2=systemctl daemon-reload

[URL32]
url32=https://github.com/AKotov-dev/MyTunnel

[PROGRAMNAME]
programname=MyTunnel

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=v0.1
1=+ Initial Release
2=+ RPM/DEB packages for Mageia/Fedora/Ubuntu
